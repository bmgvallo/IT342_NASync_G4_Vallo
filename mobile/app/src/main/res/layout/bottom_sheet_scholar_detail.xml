<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Drag handle -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="24dp">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@color/border" />
    </FrameLayout>

    <!-- Name -->
    <TextView
        android:id="@+id/tvScholarName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textColor="@color/maroon"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="serif" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Scrollable body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Scholar ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCHOLAR ID"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/tvSchoolId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/text_soft"
                android:textSize="14sp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/text_soft"
                android:textSize="14sp" />

            <!-- Department -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEPARTMENT"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/tvDepartment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/text_soft"
                android:textSize="14sp" />

            <!-- Branch -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BRANCH"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/tvBranch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/text_soft"
                android:textSize="14sp" />

            <!-- Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="14dp"
                android:background="@color/border" />

            <!-- Duty Schedule header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="DUTY SCHEDULE"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ProgressBar
                android:id="@+id/pbSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvNoSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No duty schedule assigned."
                android:textColor="@color/grey"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Schedule rows added programmatically -->
            <LinearLayout
                android:id="@+id/layoutSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Close button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Close"
                android:textColor="@color/maroon"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/off_white"
                app:cornerRadius="8dp"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
